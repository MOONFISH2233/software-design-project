<view class="login-container">
  <view class="logo-area">
    <view class="logo-circle">镜</view>
    <text class="app-name">智能化妆镜系统</text>
  </view>
  
  <view class="form-group">
    <view class="input-item">
      <text class="label">账号</text>
      <input class="input-box" placeholder="请输入账号或手机号" value="{{username}}" bindinput="onUsernameInput" />
    </view>
    <view class="input-item">
      <text class="label">密码</text>
      <input class="input-box" placeholder="请输入密码" password="true" value="{{password}}" bindinput="onPasswordInput" />
    </view>
  </view>
  
  <button class="btn-primary" bindtap="handleLogin">登 录</button>
  <view class="tips">测试账号：123 / 123456</view>
</view>
