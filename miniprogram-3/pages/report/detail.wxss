page {
  background: #f5f7fa;
}

.detail-container {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.hero {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #ffffff;
  padding: 48rpx 32rpx 56rpx;
}

.title {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.35;
  margin-bottom: 14rpx;
}

.time {
  display: block;
  font-size: 24rpx;
  opacity: 0.85;
  margin-bottom: 30rpx;
}

.score-box {
  width: 148rpx;
  height: 148rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.score {
  font-size: 44rpx;
  font-weight: 700;
}

.score-label {
  font-size: 22rpx;
}

.section {
  background: #ffffff;
  border-radius: 18rpx;
  padding: 28rpx;
  margin: 28rpx 32rpx 0;
  box-shadow: 0 6rpx 20rpx rgba(22, 24, 35, 0.05);
}

.section-title {
  font-size: 31rpx;
  font-weight: 700;
  color: #2d3340;
  margin-bottom: 18rpx;
}

.summary {
  display: block;
  color: #687080;
  font-size: 28rpx;
  line-height: 1.6;
}

.analysis-row {
  display: flex;
  justify-content: space-between;
  color: #4d5563;
  font-size: 28rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f0f2f6;
}

.analysis-row + .summary {
  margin-top: 18rpx;
}

.recommendation {
  color: #4d5563;
  font-size: 28rpx;
  line-height: 1.55;
  padding: 12rpx 0;
}

.empty-state {
  padding: 160rpx 40rpx;
  text-align: center;
  color: #9098a6;
  font-size: 28rpx;
}
