page {
  background: #f5f7fa;
}

.report-container {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.page-header {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #ffffff;
  padding: 48rpx 32rpx 54rpx;
}

.page-title {
  display: block;
  font-size: 42rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
}

.page-subtitle {
  font-size: 26rpx;
  opacity: 0.86;
}

.report-list {
  padding: 30rpx 32rpx;
}

.report-card {
  background: #ffffff;
  border-radius: 18rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(22, 24, 35, 0.06);
}

.card-top,
.card-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.report-title {
  flex: 1;
  font-size: 31rpx;
  color: #2d3340;
  font-weight: 700;
  margin-right: 20rpx;
}

.score {
  min-width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 50%;
  text-align: center;
  background: #f0ebff;
  color: #6b46c1;
  font-weight: 700;
  font-size: 30rpx;
}

.summary {
  display: block;
  color: #687080;
  font-size: 27rpx;
  line-height: 1.55;
  margin: 20rpx 0 24rpx;
}

.type {
  color: #6b46c1;
  background: #f0ebff;
  border-radius: 8rpx;
  padding: 6rpx 14rpx;
  font-size: 23rpx;
}

.time {
  color: #9aa1ad;
  font-size: 23rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 150rpx 60rpx;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  line-height: 120rpx;
  border-radius: 50%;
  text-align: center;
  background: #f0ebff;
  color: #6b46c1;
  font-size: 28rpx;
  margin-bottom: 28rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #303642;
  margin-bottom: 10rpx;
}

.empty-desc,
.load-more {
  color: #9098a6;
  font-size: 26rpx;
  text-align: center;
}

.load-more {
  padding: 20rpx;
}
