<view class="profile-container">
  <view class="user-header">
    <image wx:if="{{userInfo.avatar}}" class="avatar" src="{{userInfo.avatar}}" mode="aspectFill"></image>
    <view wx:else class="default-avatar">{{userInfo.avatarText || '我'}}</view>
    <view class="user-info">
      <text class="nickname">{{userInfo.nickname || '用户'}}</text>
      <text class="username">@{{userInfo.username || userInfo.phone || '未登录'}}</text>
      <text class="skin-tag">肤质：{{userInfo.skin_type || '未设置'}}</text>
    </view>
  </view>

  <view class="stats-section">
    <view class="stat-item" bindtap="viewDevices">
      <text class="stat-value">{{stats.totalDevices}}</text>
      <text class="stat-label">设备</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item" bindtap="viewReports">
      <text class="stat-value">{{stats.totalReports}}</text>
      <text class="stat-label">报告</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-value">{{stats.totalDays}}</text>
      <text class="stat-label">监测天数</text>
    </view>
  </view>

  <view class="menu-section">
    <view class="section-title">我的服务</view>
    <view class="menu-list">
      <view class="menu-item" bindtap="viewDevices">
        <view class="menu-left">
          <text class="menu-icon">设备</text>
          <text class="menu-text">设备管理</text>
        </view>
        <text class="arrow">></text>
      </view>
      <view class="menu-item" bindtap="viewReports">
        <view class="menu-left">
          <text class="menu-icon">报告</text>
          <text class="menu-text">健康报告</text>
        </view>
        <text class="arrow">></text>
      </view>
      <view class="menu-item" bindtap="viewNotifications">
        <view class="menu-left">
          <text class="menu-icon">通知</text>
          <text class="menu-text">消息通知</text>
        </view>
        <view class="menu-right">
          <text wx:if="{{stats.unreadNotifications > 0}}" class="badge">{{stats.unreadNotifications}}</text>
          <text class="arrow">></text>
        </view>
      </view>
    </view>
  </view>

  <view class="menu-section">
    <view class="section-title">其他</view>
    <view class="menu-list">
      <view class="menu-item" bindtap="settings">
        <view class="menu-left">
          <text class="menu-icon">设置</text>
          <text class="menu-text">系统设置</text>
        </view>
        <text class="arrow">></text>
      </view>
      <view class="menu-item" bindtap="about">
        <view class="menu-left">
          <text class="menu-icon">关于</text>
          <text class="menu-text">关于我们</text>
        </view>
        <text class="arrow">></text>
      </view>
    </view>
  </view>

  <button class="logout-btn" bindtap="logout">退出登录</button>
  <view class="version-info">智能化妆镜 v1.0.0</view>
</view>
