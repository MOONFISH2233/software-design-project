<view class="device-container">
  <!-- 顶部操作栏 -->
  <view class="header-bar">
    <text class="page-title">设备管理</text>
    <button class="btn-add" bindtap="goToBind">+ 绑定新设备</button>
  </view>

  <!-- 设备列表 -->
  <view wx:if="{{devices.length > 0}}" class="device-list">
    <view wx:for="{{devices}}" wx:key="id" class="device-card">
      <view class="card-header">
        <view class="device-info">
          <view class="device-icon">🪞</view>
          <view class="device-meta">
            <text class="device-name">{{item.device_name}}</text>
            <text class="device-id">ID: {{item.device_id}}</text>
          </view>
        </view>
        <view class="status-badge {{item.status === 'online' ? 'online' : 'offline'}}">
          {{item.status === 'online' ? '在线' : '离线'}}
        </view>
      </view>
      
      <view class="card-body">
        <view class="data-row">
          <view class="data-item">
            <text class="data-label">💧 水分</text>
            <text class="data-value">{{item.last_moisture || '--'}}%</text>
          </view>
          <view class="data-item">
            <text class="data-label">✨ 油性</text>
            <text class="data-value">{{item.last_oiliness || '--'}}</text>
          </view>
        </view>
        
        <view class="data-row">
          <view class="data-item">
            <text class="data-label">🔋 电量</text>
            <text class="data-value">{{item.battery_level || 100}}%</text>
          </view>
          <view class="data-item">
            <text class="data-label">📍 位置</text>
            <text class="data-value">{{item.location || '未设置'}}</text>
          </view>
        </view>
      </view>
      
      <view class="card-footer">
        <button class="btn-detail" data-id="{{item.id}}" bindtap="viewDeviceDetail">查看详情</button>
        <button class="btn-delete" data-id="{{item.id}}" data-name="{{item.device_name}}" bindtap="deleteDevice">删除</button>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view wx:else class="empty-state">
    <view class="empty-icon">📱</view>
    <text class="empty-text">暂无设备</text>
    <text class="empty-desc">点击右上角按钮绑定您的第一台设备</text>
    <button class="btn-primary" bindtap="goToBind">立即绑定</button>
  </view>
</view>