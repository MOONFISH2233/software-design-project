<view class="profile-container">
  <!-- 用户信息头部 -->
  <view class="user-header">
    <image class="avatar" src="{{userInfo.avatar_url || '/images/default-avatar.png'}}" mode="aspectFill"></image>
    <view class="user-info">
      <text class="nickname">{{userInfo.nickname || userInfo.username || '用户'}}</text>
      <text class="username">@{{userInfo.username || '未知'}}</text>
      <text class="skin-type">肤质: {{userInfo.skin_type || '未设置'}}</text>
    </view>
  </view>

  <!-- 统计数据 -->
  <view class="stats-section">
    <view class="stat-item">
      <text class="stat-value">{{stats.totalDevices}}</text>
      <text class="stat-label">设备</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-value">{{stats.totalReports}}</text>
      <text class="stat-label">报告</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-value">{{stats.totalDays}}</text>
      <text class="stat-label">监测天数</text>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-section">
    <view class="section-title">我的服务</view>
    
    <view class="menu-list">
      <view class="menu-item" bindtap="viewDevices">
        <view class="menu-left">
          <text class="menu-icon">📱</text>
          <text class="menu-text">设备管理</text>
        </view>
        <text class="arrow">›</text>
      </view>
      
      <view class="menu-item" bindtap="viewReports">
        <view class="menu-left">
          <text class="menu-icon">📝</text>
          <text class="menu-text">健康报告</text>
        </view>
        <text class="arrow">›</text>
      </view>
      
      <view class="menu-item" bindtap="viewNotifications">
        <view class="menu-left">
          <text class="menu-icon">🔔</text>
          <text class="menu-text">消息通知</text>
        </view>
        <view wx:if="{{stats.unreadNotifications > 0}}" class="badge">
          {{stats.unreadNotifications}}
        </view>
        <text class="arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 其他设置 -->
  <view class="menu-section">
    <view class="section-title">其他</view>
    
    <view class="menu-list">
      <view class="menu-item" bindtap="settings">
        <view class="menu-left">
          <text class="menu-icon">⚙️</text>
          <text class="menu-text">系统设置</text>
        </view>
        <text class="arrow">›</text>
      </view>
      
      <view class="menu-item" bindtap="about">
        <view class="menu-left">
          <text class="menu-icon">ℹ️</text>
          <text class="menu-text">关于我们</text>
        </view>
        <text class="arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 退出登录按钮 -->
  <view class="logout-section">
    <button class="btn-logout" bindtap="logout">退出登录</button>
  </view>
  
  <!-- 版本信息 -->
  <view class="version-info">
    <text>智能化妆镜 v1.0.0</text>
  </view>
</view>